generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String   @id @default(uuid())
  nome       String
  email_api  String?
  created_at DateTime @default(now())

  lojas       Loja[]
  produtos    ProdutoMestre[]
  vendas      Venda[]
  mapeamentos ProdutoDePara[]

  @@map("tenants")
}

model Venda {
  id              Int      @id @default(autoincrement())
  loja            Int
  loja_nome       String?
  ean             String
  plu             Int?
  produto         String
  qtd             Float
  venda           Float
  custo           Float?
  cod_interno     String?
  origem          String
  data_importacao DateTime @default(now())
  chave_unica     String   @unique
  tenant_id       String
  valor_unitario  Float?
  data            DateTime

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  loja_id           Int?
  loja_rel          Loja?          @relation(fields: [loja_id], references: [id])
  produto_mestre_id Int?
  produto_mestre    ProdutoMestre? @relation(fields: [produto_mestre_id], references: [id])

  @@index([data])
  @@index([loja])
  @@index([tenant_id])
  @@map("vendas")
}

model Loja {
  id         Int      @id @default(autoincrement())
  nome       String
  cnpj       String?
  rede       String? // Agrupamento (Ex: "Cometa", "Frangolandia")
  tenant_id  String
  created_at DateTime @default(now())

  tenant Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  vendas Venda[]

  @@index([tenant_id])
  @@map("lojas")
}

model ProdutoMestre {
  id         Int      @id @default(autoincrement())
  codigo     String // Código interno do cliente (Código X)
  nome       String
  categoria  String?
  tenant_id  String
  created_at DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  mapeamentos ProdutoDePara[]
  vendas      Venda[]

  @@unique([codigo, tenant_id])
  @@map("produtos_mestre")
}

model ProdutoDePara {
  id                Int      @id @default(autoincrement())
  codigo_api        String // Código que vem da API (Código Y)
  loja_id           Int? // Se o código for específico de uma unidade
  produto_mestre_id Int
  tenant_id         String
  created_at        DateTime @default(now())

  tenant         Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  produto_mestre ProdutoMestre @relation(fields: [produto_mestre_id], references: [id], onDelete: Cascade)

  @@unique([codigo_api, loja_id, tenant_id])
  @@map("produtos_depara")
}
