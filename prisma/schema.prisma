generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Venda {
  id              Int      @id @default(autoincrement())
  loja            Int
  loja_nome       String?
  ean             String
  plu             Int?
  produto         String
  qtd             Float
  venda           Float
  custo           Float?
  cod_interno     String?
  origem          String
  data_importacao DateTime @default(now())
  chave_unica     String   @unique
  userId          String?
  valor_unitario  Float?
  data            DateTime

  // Novos campos para arquitetura MDM
  loja_id         Int?
  loja_rel        Loja?    @relation(fields: [loja_id], references: [id])

  produto_mestre_id Int?
  produto_mestre    ProdutoMestre? @relation(fields: [produto_mestre_id], references: [id])

  @@index([data])
  @@index([loja])
  @@map("vendas")
}

model Loja {
  id          Int      @id @default(autoincrement())
  nome        String
  cnpj        String?
  rede        String?  // Agrupamento (Ex: "Cometa", "Frangolandia")
  userId      String?  // Dono da loja (Tenant)
  created_at  DateTime @default(now())

  vendas      Venda[]
  
  @@map("lojas")
}

model ProdutoMestre {
  id          Int      @id @default(autoincrement())
  codigo      String   // Código interno do cliente (Código X)
  nome        String
  categoria   String?
  userId      String?  // Dono do produto (Tenant)
  created_at  DateTime @default(now())

  mapeamentos ProdutoDePara[]
  vendas      Venda[]

  @@unique([codigo, userId])
  @@map("produtos_mestre")
}

model ProdutoDePara {
  id                Int      @id @default(autoincrement())
  codigo_api        String   // Código que vem da API (Código Y)
  loja_id           Int?     // Se o código for específico de uma unidade
  produto_mestre_id Int
  userId            String?  // Tenant
  created_at        DateTime @default(now())

  produto_mestre    ProdutoMestre @relation(fields: [produto_mestre_id], references: [id], onDelete: Cascade)

  @@unique([codigo_api, loja_id, userId])
  @@map("produtos_depara")
}

